@page "/catalogos/sucursales"
@using System.ComponentModel.DataAnnotations
@using Paqueteria.Cliente.Core.Interfaces
@using Paqueteria.Comun.Dtos.Comun
@using Paqueteria.Comun.Dtos.Sucursales
@inject ISucursalServicio SucursalServicio
@inject DialogService DialogService
@inject NotificationService NotificationService

<PageTitle>Sucursales - Paquetería</PageTitle>

<RadzenCard Class="rz-my-4 rz-p-4">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Class="rz-mb-4">
        <div>
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Class="rz-m-0" Style="font-weight: bold;">
                Gestión de Sucursales
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-color-secondary rz-m-0">
                Catálogo de sucursales de la red de transporte
            </RadzenText>
        </div>
        <RadzenButton Icon="add" Text="Nueva Sucursal" ButtonStyle="ButtonStyle.Primary" Click="OpenCreateModal" />
    </RadzenStack>

    @if (_loading)
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="min-height: 250px;">
            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText TextStyle="TextStyle.Body2" Class="rz-mt-2">Cargando sucursales...</RadzenText>
        </RadzenStack>
    }
    else
    {
        <RadzenDataGrid Data="@_sucursales"
                        TItem="SucursalRespuestaDto"
                        AllowPaging="true"
                        PageSize="10"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        ShowPagingSummary="true">
            <Columns>
                <RadzenDataGridColumn TItem="SucursalRespuestaDto" Property="Codigo" Title="Código" Width="120px" />
                
                <RadzenDataGridColumn TItem="SucursalRespuestaDto" Title="Nombre">
                    <Template Context="s">
                        <RadzenText TextStyle="TextStyle.Body1" Style="font-weight: bold;" Class="rz-m-0">
                            @s.Nombre
                        </RadzenText>
                        @if (s.EsMatriz)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Matriz" Class="rz-mt-1" />
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="SucursalRespuestaDto" Property="Telefono" Title="Teléfono" Width="150px" />

                <RadzenDataGridColumn TItem="SucursalRespuestaDto" Title="Dirección">
                    <Template Context="s">
                        @if (s.Direccion != null)
                        {
                            <span>@s.Direccion.Calle #@s.Direccion.NumeroExterior, Col. @s.Direccion.Colonia (C.P. @s.Direccion.CodigoPostal)</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="SucursalRespuestaDto" Title="Acciones" Width="120px" Sortable="false" Filterable="false">
                    <Template Context="sucursal">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Small" Click="() => OpenEditModal(sucursal)" />
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Small" Click="() => OnDesactivarSucursal(sucursal.SucursalId)" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
</RadzenCard>

@code {
    private List<SucursalRespuestaDto>? _sucursales = [];
    private SucursalFormModel _formModel = new();
    private bool _loading = false;
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadSucursalsAsync();
    }

    private async Task LoadSucursalsAsync()
    {
        _loading = true;
        try
        {
            var respuesta = await SucursalServicio.ObtenerTodosAsync();
            if (respuesta.EsExitoso)
            {
                _sucursales = respuesta.Datos ?? [];
            }
            else if (respuesta.DetalleError != null)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", respuesta.DetalleError.Description);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Error al cargar los registros");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateModal()
    {
        _formModel = new SucursalFormModel();
        await OpenFormDialog("Registro de Sucursal");
    }

    private async Task OpenEditModal(SucursalRespuestaDto sucursal)
    {
        _formModel = new SucursalFormModel
        {
            SucursalId = sucursal.SucursalId,
            Nombre = sucursal.Nombre,
            Codigo = sucursal.Codigo ?? string.Empty,
            Telefono = sucursal.Telefono ?? string.Empty,
            EsMatriz = sucursal.EsMatriz,
            Calle = sucursal.Direccion?.Calle ?? string.Empty,
            NumeroExterior = sucursal.Direccion?.NumeroExterior ?? string.Empty,
            NumeroInterior = sucursal.Direccion?.NumeroInterior ?? string.Empty,
            Colonia = sucursal.Direccion?.Colonia ?? string.Empty,
            CodigoPostal = sucursal.Direccion?.CodigoPostal ?? string.Empty,
            MunicipioId = sucursal.Direccion?.MunicipioId ?? Guid.Empty
        };
        await OpenFormDialog("Editar Sucursal");
    }

    private async Task OpenFormDialog(string title)
    {
        await DialogService.OpenAsync(title, ds =>
            @<EditForm Model="@_formModel" OnValidSubmit="() => SaveFromDialog(ds)">
                <DataAnnotationsValidator />
                <RadzenStack Gap="1rem">
                    
                    <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-color-primary rz-mb-0" Style="font-weight: bold;">
                        Datos Generales
                    </RadzenText>
                    <RadzenRow Gutter="1rem">
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Código" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@_formModel.Codigo" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenFormField Text="Nombre de Sucursal" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@_formModel.Nombre" />
                            </RadzenFormField>
                            <ValidationMessage For="@(() => _formModel.Nombre)" />
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Teléfono" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@_formModel.Telefono" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6" Class="rz-d-flex rz-align-items-center">
                            <RadzenCheckBox @bind-Value="@_formModel.EsMatriz" Name="chkMatriz" />
                            <RadzenLabel Text="¿Es Casa Matriz?" Component="chkMatriz" Class="rz-ml-2" />
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-color-primary rz-mb-0" Style="font-weight: bold;">
                        Dirección
                    </RadzenText>
                    <RadzenRow Gutter="1rem">
                        <RadzenColumn Size="12" SizeMD="8">
                            <RadzenFormField Text="Calle" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@_formModel.Calle" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="4">
                            <RadzenFormField Text="Número Exterior" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@_formModel.NumeroExterior" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Colonia" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@_formModel.Colonia" />
                            </RadzenFormField>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMD="6">
                            <RadzenFormField Text="Código Postal" Variant="Variant.Outlined" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="@_formModel.CodigoPostal" />
                            </RadzenFormField>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Class="rz-mt-4">
                        <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="() => ds.Close(false)" />
                        <RadzenButton Text="Guardar" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" IsBusy="@_saving" />
                    </RadzenStack>
                </RadzenStack>
            </EditForm>,
            new DialogOptions { Width = "700px", Resizable = true, Draggable = true }
        );
    }

    private async Task SaveFromDialog(DialogService ds)
    {
        _saving = true;
        try
        {
            var direccionDto = new DireccionDto(
                _formModel.Calle,
                _formModel.NumeroExterior,
                _formModel.NumeroInterior,
                _formModel.Colonia,
                _formModel.CodigoPostal,
                string.Empty,
                _formModel.MunicipioId
            );

            bool success;
            string? mensajeError = null;

            if (!_formModel.SucursalId.HasValue)
            {
                var sucursalCrear = new SucursalCrearDto(
                    _formModel.Nombre,
                    _formModel.Codigo,
                    _formModel.EsMatriz,
                    direccionDto,
                    _formModel.Telefono
                );
                var respuesta = await SucursalServicio.CrearAsync(sucursalCrear);
                success = respuesta.EsExitoso;
                mensajeError = respuesta.DetalleError?.Description;
            }
            else
            {
                var sucursalActualizar = new SucursalActualizarDto(
                    _formModel.SucursalId.Value,
                    _formModel.Nombre,
                    _formModel.Codigo,
                    _formModel.EsMatriz,
                    direccionDto,
                    _formModel.Telefono
                );
                var respuesta = await SucursalServicio.ActualizarAsync(sucursalActualizar.SucursalId, sucursalActualizar);
                success = respuesta.EsExitoso;
                mensajeError = respuesta.DetalleError?.Description;
            }

            if (success)
            {
                ds.Close(true);
                NotificationService.Notify(NotificationSeverity.Success, "Éxito", "Registro guardado correctamente");
                await LoadSucursalsAsync();
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", mensajeError ?? "Ocurrió un error al guardar el registro");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "Ocurrió un error inesperado");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnDesactivarSucursal(Guid id)
    {
        var confirmResult = await DialogService.Confirm(
            "Esta acción cambiará el estatus del registro y podría afectar operaciones relacionadas.",
            "¿Está seguro de desactivar esta sucursal?",
            new ConfirmOptions { OkButtonText = "Aceptar", CancelButtonText = "Cancelar" }
        );

        if (confirmResult == true)
        {
            try
            {
                var respuesta = await SucursalServicio.EliminarAsync(id);
                if (respuesta.EsExitoso)
                {
                    NotificationService.Notify(NotificationSeverity.Success, "Éxito", "Registro desactivado correctamente");
                    await LoadSucursalsAsync();
                }
                else
                {
                    NotificationService.Notify(NotificationSeverity.Error, "Error", respuesta.DetalleError?.Description ?? "No se pudo desactivar el registro");
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", "Ocurrió un error al intentar desactivar el registro");
                Console.WriteLine(ex.Message);
            }
        }
    }

    private class SucursalFormModel
    {
        public Guid? SucursalId { get; set; }

        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string Nombre { get; set; } = string.Empty;
        
        public string Codigo { get; set; } = string.Empty;
        public bool EsMatriz { get; set; } = false;
        public string Telefono { get; set; } = string.Empty;

        // Propiedades aplanadas para el binding del formulario de Dirección
        public string Calle { get; set; } = string.Empty;
        public string NumeroExterior { get; set; } = string.Empty;
        public string NumeroInterior { get; set; } = string.Empty;
        public string Colonia { get; set; } = string.Empty;
        public string CodigoPostal { get; set; } = string.Empty;
        public Guid MunicipioId { get; set; } = Guid.Empty;
    }
}
